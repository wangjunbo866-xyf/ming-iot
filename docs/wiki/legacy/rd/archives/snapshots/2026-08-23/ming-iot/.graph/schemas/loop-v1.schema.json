{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ming.io/schemas/graph/loop-v1.schema.json",
  "title": "ming.io R&D Graph Registry documents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": true,
    "kind": true,
    "schema": true,
    "loopsDir": true,
    "runtimeDir": true,
    "controlPlane": true,
    "metadata": true,
    "spec": true
  },
  "oneOf": [
    {
      "$ref": "#/$defs/registryDocument"
    },
    {
      "$ref": "#/$defs/loopDocument"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "registryDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schema",
        "loopsDir",
        "runtimeDir",
        "controlPlane"
      ],
      "properties": {
        "apiVersion": {
          "const": "graph.ming.io/v1"
        },
        "kind": {
          "const": "Registry"
        },
        "schema": {
          "$ref": "#/$defs/path"
        },
        "loopsDir": {
          "$ref": "#/$defs/path"
        },
        "runtimeDir": {
          "$ref": "#/$defs/path"
        },
        "controlPlane": {
          "$ref": "#/$defs/controlPlane"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerLoop",
        "globalImpact"
      ],
      "properties": {
        "ownerLoop": {
          "$ref": "#/$defs/id"
        },
        "globalImpact": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "loopDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "graph.ming.io/v1"
        },
        "kind": {
          "const": "Loop"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "$ref": "#/$defs/loopSpec"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metadata": {
                "properties": {
                  "id": {
                    "const": "L0-things-baseline"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "metadata"
            ]
          },
          "then": {
            "properties": {
              "spec": {
                "properties": {
                  "completion": {
                    "oneOf": [
                      {
                        "required": [
                          "reviewRef"
                        ],
                        "not": {
                          "required": [
                            "legacyReviewRefs"
                          ]
                        }
                      },
                      {
                        "required": [
                          "legacyReviewRefs"
                        ],
                        "properties": {
                          "legacyReviewRefs": {
                            "minItems": 1
                          }
                        },
                        "not": {
                          "required": [
                            "reviewRef"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "spec": {
                "properties": {
                  "completion": {
                    "required": [
                      "reviewRef"
                    ],
                    "not": {
                      "required": [
                        "legacyReviewRefs"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loopSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "dependsOn",
        "scope",
        "gates",
        "evidence",
        "review"
      ],
      "properties": {
        "lifecycle": {
          "enum": [
            "planned",
            "active",
            "closed"
          ]
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "completion": {
          "$ref": "#/$defs/completion"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "closed"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "required": [
              "completion"
            ]
          },
          "else": {
            "not": {
              "required": [
                "completion"
              ]
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "watches": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "externalSources": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/externalSource"
          }
        }
      }
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "access"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "access": {
          "const": "read-only"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required",
        "validator",
        "workdir",
        "argv",
        "timeout"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "command"
        },
        "required": {
          "type": "boolean"
        },
        "validator": {
          "$ref": "#/$defs/validator"
        },
        "workdir": {
          "$ref": "#/$defs/path"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 6,
          "properties": {
            "GOWORK": { "type": "string" },
            "GOFLAGS": { "type": "string" },
            "CGO_ENABLED": { "type": "string" },
            "TZ": { "type": "string" },
            "LANG": { "type": "string" },
            "LC_ALL": { "type": "string" }
          }
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sourcePaths"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredForCompletion",
        "subjectPaths"
      ],
      "properties": {
        "requiredForCompletion": {
          "type": "boolean"
        },
        "subjectPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "canonical": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredForCompletion"
      ],
      "properties": {
        "requiredForCompletion": {
          "type": "boolean"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectCommit",
        "subjectScopeDigest",
        "registryDigest",
        "dependencyDigests",
        "evidenceRefs"
      ],
      "properties": {
        "subjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "subjectScopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "registryDigest": {
          "$ref": "#/$defs/digest"
        },
        "dependencyDigests": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 256,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "reviewRef": {
          "$ref": "#/$defs/artifact"
        },
        "legacyReviewRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  }
}
