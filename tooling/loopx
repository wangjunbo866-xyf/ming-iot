#!/usr/bin/env python3
"""Use this checkout's private LoopX route without creating another Goal."""
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    root = Path(__file__).resolve().parents[1]
    try:
        common = subprocess.check_output(
            ["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            text=True,
        ).strip()
        config_path = Path(common).parent / ".local/loopx.json"
        config = json.loads(config_path.read_text())
        binary = Path(config["binary"])
        registry = Path(config["registry"])
        if not binary.is_absolute() or not os.access(binary, os.X_OK):
            raise ValueError("binary must be an absolute executable path")
        if not registry.is_absolute() or not registry.is_file():
            raise ValueError("registry must be an existing absolute file path")
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"LoopX route unavailable: {error}. See docs/runbook/daily-development.md.", file=sys.stderr)
        return 2
    os.execv(str(binary), [str(binary), "--registry", str(registry), *sys.argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
