info(
    title: "用户数据权限管理模块"
    desc: "用户数据权限管理接口"
    author: "godLei6"
    email: "603785348@qq.com"
    version: "v1"
)


@server (
    group: system/user/dept
    prefix: /api/v1/system/user/dept
    accessCodePrefix: "systemUserManage"
    accessNamePrefix: "用户部门"
    accessGroup: "用户管理"
    defaultAuthType: "admin"
    defaultNeedAuth: "true"
    middleware:  CheckTokenWare,InitCtxsWare
)
service api {
    @doc(
        summary: "新增用户的部门列表"
        description: "把指定用户批量加入多个部门，建立用户与部门的隶属关系"
        authType: "admin"
        resource: "user"
        action: "bind"
        group: "system/user/dept"
        recordLogMode: "2"
    )
    @handler multiCreate
    post /multi-create (UserDeptMultiSaveReq) returns ()
    @doc(
        summary: "删除用户的部门列表"
        description: "移除指定用户与多个部门的隶属关系，不影响用户账号本身"
        authType: "admin"
        resource: "user"
        action: "unbind"
        group: "system/user/dept"
        recordLogMode: "2"
    )
    @handler multiDelete
    post /multi-delete (UserDeptMultiSaveReq) returns ()
}


//用户级权限控制
type (
    UserDeptMultiSaveReq{
        UserID         int64  `json:"userID,string"`        // 用户id
        DeptIDs 		[]int64 `json:"deptIDs,string"` //角色编号列表
    }
)