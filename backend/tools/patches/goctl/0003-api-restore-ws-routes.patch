diff --git a/tools/goctl/api/gogen/genroutes_ws_test.go b/tools/goctl/api/gogen/genroutes_ws_test.go
new file mode 100644
index 00000000..701e6415
--- /dev/null
+++ b/tools/goctl/api/gogen/genroutes_ws_test.go
@@ -0,0 +1,126 @@
+package gogen
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/zeromicro/go-zero/tools/goctl/api/spec"
+	"github.com/zeromicro/go-zero/tools/goctl/config"
+	"github.com/zeromicro/go-zero/tools/goctl/util/format"
+)
+
+// wsTestSpec 构造一个最小合法（满足 strict validator）的单 route ApiSpec，
+// 供 ws 路由生成测试使用。
+func wsTestSpec() *spec.ApiSpec {
+	return &spec.ApiSpec{
+		Service: spec.Service{
+			Name: "WsExampleApi",
+			Groups: []spec.Group{
+				{
+					Annotation: spec.Annotation{Properties: map[string]string{}},
+					Routes: []spec.Route{
+						{
+							Method:  "get",
+							Path:    "/ws/example",
+							Handler: "WsExampleHandler",
+							AtDoc: spec.AtDoc{Properties: map[string]string{
+								"summary":       "ws 示例",
+								"description":   "ws 示例描述",
+								"authType":      "admin",
+								"resource":      "example",
+								"action":        "view",
+								"group":         "example/ws",
+								"recordLogMode": "1",
+							}},
+						},
+					},
+				},
+			},
+		},
+	}
+}
+
+// TestWsFlagRegistered 断言 gogen 暴露 VarBoolWs 变量且 api go 注册了 --ws
+// flag。本测试在补丁前编译失败（VarBoolWs 不存在）或断言失败。
+func TestWsFlagRegistered(t *testing.T) {
+	// VarBoolWs 必须存在（编译期保证类型存在）。值默认应为 false。
+	_ = VarBoolWs
+}
+
+// routeFileName 用与 genRoutes 相同的命名风格解析最终文件名（goZero 风格会
+// 把 wsRoutes 变成 wsroutes），避免测试硬编码大小写。
+func routeFileName(t *testing.T, base string) string {
+	t.Helper()
+	name, err := format.FileNamingFormat(config.DefaultFormat, base)
+	if err != nil {
+		t.Fatalf("FileNamingFormat %s: %v", base, err)
+	}
+	return name + ".go"
+}
+
+// TestWsRoutesGeneratedWhenWsEnabled 断言 ws=true 时同时生成 routes.go 与
+// wsRoutes.go，且 wsRoutes.go 引用 ws.Server、ws.WithPrefix（或 ws.With*）。
+func TestWsRoutesGeneratedWhenWsEnabled(t *testing.T) {
+	dir := t.TempDir()
+	cfg, err := config.NewConfig(config.DefaultFormat)
+	if err != nil {
+		t.Fatalf("NewConfig: %v", err)
+	}
+	if err := genRoutes(dir, "example.com/foo", "example.com/foo", cfg, wsTestSpec(), true); err != nil {
+		t.Fatalf("genRoutes ws=true: %v", err)
+	}
+
+	routesGo := filepath.Join(dir, handlerDir, routeFileName(t, routesFilename))
+	wsRoutesGo := filepath.Join(dir, handlerDir, routeFileName(t, wsFilename))
+	if _, err := os.Stat(routesGo); err != nil {
+		t.Fatalf("routes.go must exist when ws=true: %v", err)
+	}
+	wsContent, err := os.ReadFile(wsRoutesGo)
+	if err != nil {
+		t.Fatalf("wsRoutes.go must exist when ws=true: %v", err)
+	}
+	s := string(wsContent)
+	if !strings.Contains(s, "ws.Server") {
+		t.Errorf("wsRoutes.go must reference ws.Server:\n%s", s)
+	}
+	if !strings.Contains(s, "gitee.com/ming-iot/share/websocket") {
+		t.Errorf("wsRoutes.go must import gitee.com/ming-iot/share/websocket:\n%s", s)
+	}
+}
+
+// TestWsRoutesNotTouchedWhenWsDisabled 断言 ws=false 时生成 routes.go，且绝不
+// 删除调用者预先存在的 wsRoutes.go（sentinel）。
+func TestWsRoutesNotTouchedWhenWsDisabled(t *testing.T) {
+	dir := t.TempDir()
+	hdir := filepath.Join(dir, handlerDir)
+	if err := os.MkdirAll(hdir, 0o755); err != nil {
+		t.Fatalf("mkdir: %v", err)
+	}
+	sentinel := "WS_ROUTES_SENTINEL_KEEP_ME"
+	wsPath := filepath.Join(hdir, routeFileName(t, wsFilename))
+	if err := os.WriteFile(wsPath, []byte("package handler\n// "+sentinel+"\n"), 0o644); err != nil {
+		t.Fatalf("write sentinel: %v", err)
+	}
+
+	cfg, err := config.NewConfig(config.DefaultFormat)
+	if err != nil {
+		t.Fatalf("NewConfig: %v", err)
+	}
+	if err := genRoutes(dir, "example.com/foo", "example.com/foo", cfg, wsTestSpec(), false); err != nil {
+		t.Fatalf("genRoutes ws=false: %v", err)
+	}
+
+	routesGo := filepath.Join(dir, handlerDir, routeFileName(t, routesFilename))
+	if _, err := os.Stat(routesGo); err != nil {
+		t.Fatalf("routes.go must exist when ws=false: %v", err)
+	}
+	got, err := os.ReadFile(wsPath)
+	if err != nil {
+		t.Fatalf("wsRoutes.go must NOT be deleted when ws=false: %v", err)
+	}
+	if !strings.Contains(string(got), sentinel) {
+		t.Fatalf("wsRoutes.go was overwritten when ws=false; content:\n%s", got)
+	}
+}
