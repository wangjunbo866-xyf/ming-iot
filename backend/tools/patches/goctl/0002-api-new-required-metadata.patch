diff --git a/tools/goctl/api/new/template_metadata_test.go b/tools/goctl/api/new/template_metadata_test.go
new file mode 100644
index 00000000..cc7438fb
--- /dev/null
+++ b/tools/goctl/api/new/template_metadata_test.go
@@ -0,0 +1,66 @@
+package new
+
+import (
+	"bytes"
+	"html/template"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/zeromicro/go-zero/tools/goctl/api/parser"
+)
+
+// renderNewApiTpl 渲染 new/api.tpl，模拟 CreateServiceCommand 写入 .api 文件
+// 的真实数据契约（name/handler）。返回渲染后的 .api 内容。
+func renderNewApiTpl(t *testing.T) string {
+	t.Helper()
+	tpl := template.Must(template.New("api").Parse(apiTemplate))
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, map[string]string{
+		"name":    "example",
+		"handler": "Example",
+	}); err != nil {
+		t.Fatalf("render new/api.tpl: %v", err)
+	}
+	return buf.String()
+}
+
+func parseValidateFileNew(t *testing.T, content string) error {
+	t.Helper()
+	dir := t.TempDir()
+	f := filepath.Join(dir, "rendered.api")
+	if err := os.WriteFile(f, []byte(content), 0o644); err != nil {
+		t.Fatalf("write tmp api: %v", err)
+	}
+	spec, err := parser.Parse(f)
+	if err != nil {
+		return err
+	}
+	return spec.Validate()
+}
+
+// TestNewApiTemplatePassesStrictValidate 断言 new/api.tpl 渲染结果通过 strict
+// ApiSpec.Validate()。`goctl api new` 在 CreateServiceCommand 里会立刻调用
+// DoGenProjectWithModule → parser.Parse → Validate，因此模板本身必须默认满足
+// 七项 metadata，否则生成的脚手架无法编译/生成。
+func TestNewApiTemplatePassesStrictValidate(t *testing.T) {
+	content := renderNewApiTpl(t)
+	if !strings.Contains(content, "service ") {
+		t.Fatalf("rendered template missing service block:\n%s", content)
+	}
+	if err := parseValidateFileNew(t, content); err != nil {
+		t.Fatalf("new/api.tpl must satisfy strict Validate after patch: %v", err)
+	}
+}
+
+// TestNewApiTemplateNoHandlerOnlyRoute 断言模板不再生成只有 @handler 没有
+// @doc 的 route。每个 @handler 必须对应一个 @doc(...) 块。
+func TestNewApiTemplateNoHandlerOnlyRoute(t *testing.T) {
+	content := renderNewApiTpl(t)
+	docBlocks := strings.Count(content, "@doc(")
+	handlers := strings.Count(content, "@handler")
+	if docBlocks != handlers {
+		t.Fatalf("template @doc( blocks (%d) must equal @handler count (%d)", docBlocks, handlers)
+	}
+}
