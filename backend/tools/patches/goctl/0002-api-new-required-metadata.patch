diff --git a/tools/goctl/api/apigen/template_metadata_test.go b/tools/goctl/api/apigen/template_metadata_test.go
new file mode 100644
index 00000000..e5309125
--- /dev/null
+++ b/tools/goctl/api/apigen/template_metadata_test.go
@@ -0,0 +1,70 @@
+package apigen
+
+import (
+	"bytes"
+	"html/template"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/zeromicro/go-zero/tools/goctl/api/parser"
+)
+
+// renderApiTpl 渲染 apigen/api.tpl，模拟 CreateApiTemplate 写入 .api 文件
+// 的真实数据契约（gitUser/gitEmail/serviceName）。返回渲染后的 .api 内容。
+func renderApiTpl(t *testing.T) string {
+	t.Helper()
+	tpl := template.Must(template.New("api").Parse(apiTemplate))
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, map[string]string{
+		"gitUser":     "tester",
+		"gitEmail":    "tester@example.com",
+		"serviceName": "example-api",
+	}); err != nil {
+		t.Fatalf("render apigen/api.tpl: %v", err)
+	}
+	return buf.String()
+}
+
+// parseValidateFile 把 .api 内容写入临时文件，走与 DoGenProject 完全一致的
+// parser.Parse(file) → ApiSpec.Validate() 路径（file-based parse 会剥引号）。
+func parseValidateFile(t *testing.T, content string) error {
+	t.Helper()
+	dir := t.TempDir()
+	f := filepath.Join(dir, "rendered.api")
+	if err := os.WriteFile(f, []byte(content), 0o644); err != nil {
+		t.Fatalf("write tmp api: %v", err)
+	}
+	spec, err := parser.Parse(f)
+	if err != nil {
+		return err
+	}
+	return spec.Validate()
+}
+
+// TestApiTemplatePassesStrictValidate 断言 apigen/api.tpl 渲染结果通过 strict
+// ApiSpec.Validate()。原始模板每条 route 只有 @handler，缺七项 metadata，
+// 本测试在补丁前应为红；补丁把每条 route 改成 @doc(...) + @handler 后转绿。
+func TestApiTemplatePassesStrictValidate(t *testing.T) {
+	content := renderApiTpl(t)
+	// 模板至少要包含 service 块，防止渲染空壳悄悄绕过校验。
+	if !strings.Contains(content, "service ") {
+		t.Fatalf("rendered template missing service block:\n%s", content)
+	}
+	if err := parseValidateFile(t, content); err != nil {
+		t.Fatalf("apigen/api.tpl must satisfy strict Validate after patch: %v", err)
+	}
+}
+
+// TestApiTemplateNoHandlerOnlyRoute 断言模板不再生成只有 @handler 没有 @doc
+// 的 route（这是导致 strict validator 失败的根因）。每个 @handler 必须对应
+// 一个 @doc(...) 块。
+func TestApiTemplateNoHandlerOnlyRoute(t *testing.T) {
+	content := renderApiTpl(t)
+	docBlocks := strings.Count(content, "@doc(")
+	handlers := strings.Count(content, "@handler")
+	if docBlocks != handlers {
+		t.Fatalf("template @doc( blocks (%d) must equal @handler count (%d)", docBlocks, handlers)
+	}
+}
